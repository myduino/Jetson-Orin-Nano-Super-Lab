{
  "name": "myduino-jetson-lab",
  "productName": "Myduino Jetson Lab",
  "version": "1.0.0",
  "description": "Teacher app of the Myduino Jetson Orin Nano Super lab",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.myduino.jetsonlab",
    "productName": "Myduino Jetson Lab",
    "files": ["main.js", "preload.js", "server.js", "portal.html", "launcher.html", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "artifactName": "myduino-jetson-lab.exe" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.education", "artifactName": "myduino-jetson-lab-${arch}.${ext}", "identity": null }
  }
}
